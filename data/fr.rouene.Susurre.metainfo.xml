<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fr.rouene.Susurre</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Susurre</name>
  <summary>Local voice dictation for GNOME</summary>
  <description>
    <p>
      Susurre turns speech into text, entirely on your machine. Hold the
      shortcut, speak, and the text is typed into the focused application.
    </p>
    <p>Two engines to choose from: whisper.cpp and faster-whisper (CTranslate2).</p>
  </description>
  <launchable type="desktop-id">fr.rouene.Susurre.desktop</launchable>
  <url type="homepage">https://github.com/arouene/Susurre</url>
  <url type="bugtracker">https://github.com/arouene/Susurre/issues</url>
  <!-- The developer id shares the namespace of the application id. -->
  <developer id="fr.rouene">
    <name>Aurelien Rouene</name>
  </developer>
  <update_contact>aurelien@rouene.fr</update_contact>
  <content_rating type="oars-1.1"/>
  <!-- AppStream takes PNG or JPEG here, never GIF, and the URL has to be
       reachable: Flathub renders these from the web, not from the build. -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/arouene/Susurre/main/screenshots/settings1.png</image>
      <caption>Choosing the engine, the model, the language and the dictation shortcut</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/arouene/Susurre/main/screenshots/settings2.png</image>
      <caption>Text replacements, and the models downloaded on this machine</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.0.1" date="2026-08-31"/>
    <release version="1.0.0" date="2026-08-29"/>
    <release version="0.1.0" date="2026-08-26"/>
  </releases>
</component>
